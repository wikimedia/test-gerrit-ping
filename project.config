[project]
	description = Test project for gerrit and it's plugins/connections
[access "refs/*"]
	owner = group Gerrit Managers
	owner = group ldap/wmf
	push = group Gerrit Managers
	submit = group Gerrit Managers
	submit = group JenkinsBot
[access "refs/tags/*"]
	delete = group Gerrit Managers
[label "Code-Review"]
    function = NoBlock
    abbreviation = R
    value = -2 Do not submit
    value = -1 There's a problem with this change, please improve
    value = 0 No score
    value = +1 Looks good to me, but someone else must approve
    value = +2 Looks good to me, approved
    defaultValue = 0
	copyCondition = changekind:NO_CHANGE OR changekind:NO_CODE_CHANGE OR changekind:TRIVIAL_REBASE OR is:MIN
[label "Verified"]
    function = MaxWithBlock
    value = -1 Fails
    value = 0 No score
    value = +1 Checked
    value = +2 Verified
    defaultValue = 0
	copyCondition = changekind:NO_CHANGE
[access "refs/for/refs/heads/main"]
	push = block group Registered Users
[access "refs/heads/blockedbranch"]
	create = block group Registered Users

[label "Unfreeze"]
    value = 0 Change is blocked due to code freeze
    value = +1 Allow this change to pass through
	function = MaxWithBlock
	defaultValue = 0

[access "refs/heads/codex"]
	label-Unfreeze = +0..+1 group Administrators
[submit-requirement "Code-Review"]
	applicableIf = branch:codex label:Unfreeze=+1
	submittableIf = label:Code-Review=2 AND -label:My-Label=-2
	canOverrideInChildProjects = false
